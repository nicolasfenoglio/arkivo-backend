{
  "name": "arkivo-backend",
  "version": "1.0.0",
  "description": "Backend para la plataforma Arkivo, un sistema de gestión de apuntes académicos.",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "infra:up": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d",
    "infra:down": "docker compose -f docker-compose.yml -f docker-compose.dev.yml down",
    "infra:restart": "docker compose -f docker-compose.yml -f docker-compose.dev.yml restart",
    "infra:logs": "docker compose -f docker-compose.yml -f docker-compose.dev.yml logs -f",
    "dev:full": "pnpm run infra:up && pnpm run dev",
    "docker:up": "docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d",
    "docker:down": "docker compose -f docker-compose.yml -f docker-compose.prod.yml down",
    "docker:logs": "docker compose -f docker-compose.yml -f docker-compose.prod.yml logs -f"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1071.0",
    "@aws-sdk/s3-request-presigner": "^3.1071.0",
    "@sequelize/core": "7.0.0-alpha.48",
    "@sequelize/postgres": "7.0.0-alpha.48",
    "@types/cors": "^2.8.19",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-validator": "^7.3.2",
    "firebase-admin": "^14.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3"
  }
}
