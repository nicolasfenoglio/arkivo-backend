{
  "name": "arkivo-backend",
  "version": "1.0.0",
  "description": "Backend para la plataforma Arkivo, un sistema de gestión de apuntes académicos.",
  "main": "./src/index.js",
  "type": "module",
  "scripts": {
    "start": "docker compose up -d",
    "dev": "nodemon . --watch src",
    "infra:up": "docker compose up -d postgres minio minio-init",
    "infra:down": "docker compose down",
    "infra:restart": "docker compose restart",
    "infra:logs": "docker compose logs -f",
    "dev:full": "pnpm run infra:up && pnpm run dev"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1068.0",
    "@aws-sdk/lib-storage": "^3.1068.0",
    "@aws-sdk/s3-request-presigner": "^3.1068.0",
    "@sequelize/postgres": "7.0.0-alpha.48",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-validator": "^7.3.2",
    "multer": "^2.1.1",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
